# Configuración de Producción Gateway WhatsApp
PORT=3000
NODE_ENV=production

# Seguridad Criptográfica JWT (Generar con: openssl rand -base64 32)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui

# Credenciales de Administrador del Sistema
ADMIN_USER=admin
ADMIN_PASS=CambiaEstaContrasenaSegura2026!
ADMIN_EMAIL=admin@tudominio.com

# Servicio de Correo SMTP para Códigos de Verificación 2FA
SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_gmail

# Orígenes CORS permitidos, separados por comas (sin asterisco)
CORS_ORIGIN=https://bot-whatsapp-mensajes-automatico.vercel.app

# Base de Datos MongoDB Atlas (Opcional - Si no se configura, opera en modo local seguro con cifrado AES-256)
# Ejemplo: mongodb+srv://usuario:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=whatsapp_bot
